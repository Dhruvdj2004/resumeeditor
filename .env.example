# Free-tier friendly: add as many keys as you like. Providers are tried in PROVIDER_ORDER;
# if one is busy or rate-limited, the next one is used automatically. Empty keys are skipped.
PROVIDER_ORDER=groq,cerebras,gemini,openrouter

# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# https://openrouter.ai/keys  (":free" models cost nothing; list several, comma-separated, as backups)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,qwen/qwen3.8-27b:free

# Seconds allowed for a LaTeX compile (first run downloads packages, so keep this generous)
COMPILE_TIMEOUT=120
