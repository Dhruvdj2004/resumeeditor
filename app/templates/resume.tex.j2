\documentclass[10pt,letterpaper]{article}

\usepackage[top=0.45in,bottom=0.45in,left=0.55in,right=0.55in]{geometry}
\usepackage{fontspec}
\setmainfont{texgyreheros}[
  Extension=.otf,
  UprightFont=*-regular,
  BoldFont=*-bold,
  ItalicFont=*-italic,
  BoldItalicFont=*-bolditalic
]
\usepackage{xcolor}
\usepackage{titlesec}
\usepackage{enumitem}
\usepackage{tabularx}
\usepackage[hidelinks]{hyperref}

\definecolor{accent}{HTML}{1F3A68}
\definecolor{muted}{HTML}{5F6368}
\definecolor{rulegray}{HTML}{D5D9E0}

\pagestyle{empty}
\setlength{\parindent}{0pt}
\raggedright
\linespread{1.05}

\newcommand{\sectionrule}[1]{{\addfontfeature{LetterSpace=12}\MakeUppercase{#1}}\hspace{8pt}{\color{rulegray}\leaders\hrule height 0.5pt\hfill\kern0pt}}
\titleformat{\section}{\color{accent}\bfseries\small}{}{0em}{\sectionrule}
\titlespacing*{\section}{0pt}{7pt}{3pt}

\newcommand{\resumeHeaderRule}{\vspace{2pt}{\color{accent}\rule{\linewidth}{1.2pt}}\vspace{-6pt}}
\newcommand{\resumeSubheading}[4]{%
  \par\vspace{3pt}%
  \textbf{#1}\hfill{\color{muted}#2}\par
  \if\relax\detokenize{#3#4}\relax\else
  {\color{muted}\small\itshape #3}\hfill{\color{muted}\small #4}\par
  \fi
}
\newcommand{\resumeItem}[1]{\item #1}
\newcommand{\resumeItemListStart}{\begin{itemize}[leftmargin=13pt,itemsep=0pt,topsep=1pt,parsep=0pt,partopsep=0pt,label={\color{muted}\textbullet}]}
\newcommand{\resumeItemListEnd}{\end{itemize}}
\newcommand{\resumeSkillsStart}{\par\vspace{2pt}\begin{tabular}{@{}p{1.35in}p{\dimexpr\linewidth-1.35in\relax}@{}}}
\newcommand{\resumeSkillsEnd}{\end{tabular}\par}
\newcommand{\resumeSkill}[2]{\textbf{#1} & #2 \\}

\begin{document}
%%BODY_START
%%BEGIN:HEADER
\begin{center}
  {\fontsize{22}{26}\selectfont\bfseries (((( r.name|tex ))))}\\[3pt]
((* if r.headline *))
  {\color{accent}\bfseries (((( r.headline|tex ))))}\\[3pt]
((* endif *))
  {\small\color{muted}((* for c in r.contact *))((* if not loop.first *))~\textbullet\hspace{0.5em}((* endif *))((* if c.url *))\href{(((( c.url|url ))))}{(((( c.text|tex ))))}((* else *))(((( c.text|tex ))))((* endif *))((* endfor *))}
\end{center}
\resumeHeaderRule
%%END:HEADER
((* for sec in r.sections *))
%%BEGIN:(((( sec.marker ))))
\section{(((( sec.title|tex ))))}
((* if sec.type == "entries" *))
((* for e in sec.entries *))
\resumeSubheading{(((( e.title|tex ))))}{(((( e.date|tex ))))}{(((( e.subtitle|tex ))))}{(((( e.meta|tex ))))}
((* if e.bullets *))
\resumeItemListStart
((* for b in e.bullets *))
  \resumeItem{(((( b|rich ))))}
((* endfor *))
\resumeItemListEnd
((* endif *))
((* endfor *))
((* elif sec.type == "skills" *))
\resumeSkillsStart
((* for row in sec.rows *))
  \resumeSkill{(((( row.label|tex ))))}{(((( row.value|rich ))))}
((* endfor *))
\resumeSkillsEnd
((* elif sec.type == "bullets" *))
\resumeItemListStart
((* for it in sec['items'] *))
  \resumeItem{(((( it|rich ))))}
((* endfor *))
\resumeItemListEnd
((* else *))
(((( sec.text|rich ))))
((* endif *))
%%END:(((( sec.marker ))))
((* endfor *))
%%BODY_END
\end{document}
